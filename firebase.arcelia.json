{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/data/*.xlsx",
      "**/data/*.json"
    ],
    "rewrites": [
      {
        "source": "/api/discordLogin",
        "function": "discordLogin"
      },
      {
        "source": "/api/discordCallback",
        "function": "discordCallback"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "kdmanagerdb",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "serviceAccountKey.json",
        "service-account.json",
        "kd-*-manager.json",
        "all_users*.json",
        "output.json"
      ],
      "predeploy": [
        "cd functions && npm run lint"
      ]
    }
  ]
}
