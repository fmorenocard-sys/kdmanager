VITE_FIREBASE_API_KEY=AIzaKy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Google Sheet ID of the live KvK workbook (optional; digest falls back to the committed xlsx)
KVK_SHEET_ID=your-google-sheet-file-id

# --- Marque blanche (facultatif) ---
# Sans ces variables, l'app affiche l'identité d'Unitas 2997 par défaut.
# Un autre royaume les définit dans son fichier d'env de build (ex. .env.pilot).
VITE_APP_NAME=Kingdom Manager
VITE_KINGDOM_NAME=Unitas 2997
VITE_APP_SHORT=KD Manager
VITE_KINGDOM_NUMBER=2997
VITE_LOGO_URL=/logo.png
