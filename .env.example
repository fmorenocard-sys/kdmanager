VITE_FIREBASE_API_KEY=AIzaKy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Google Sheet ID of the live KvK workbook (optional; digest falls back to the committed xlsx)
KVK_SHEET_ID=your-google-sheet-file-id

# --- Marque blanche (facultatif) ---
# Sans ces variables, l'app affiche l'identité d'Unitas 2997 par défaut.
# Un autre royaume les définit dans son fichier d'env de build (ex. .env.pilot).
VITE_APP_NAME=Kingdom Manager
VITE_KINGDOM_NAME=Unitas 2997
VITE_APP_SHORT=KD Manager
VITE_KINGDOM_NUMBER=2997
VITE_LOGO_URL=/logo.png
# Favicon et avatar par défaut : suivent VITE_LOGO_URL si non définis.
# Déposer l'image du royaume dans public/ (ex. /logo-3341.png) et pointer dessus.
# VITE_FAVICON_URL=/logo.png
# VITE_DEFAULT_AVATAR_URL=/logo.png
# URL canonique de l'instance. Les aperçus de lien (WhatsApp, Discord…) lisent le
# HTML statique sans exécuter le JS : le <head> porte donc titre/favicon/Open Graph
# par instance, posés au build (plugin html-branding-meta de vite.config.js).
# VITE_PUBLIC_URL rend l'og:image ABSOLUE (obligatoire pour les crawlers) et sert d'og:url.
VITE_PUBLIC_URL=https://your-project.web.app
# Facultatif : forcer une image d'aperçu dédiée (idéalement ~1200x630) et un texte.
# Par défaut l'og:image = VITE_PUBLIC_URL + VITE_LOGO_URL (le logo, en vignette carrée).
# VITE_OG_IMAGE_URL=https://your-project.web.app/og-banner.png
# VITE_OG_DESCRIPTION=Community war & KvK dashboard.

# Activation de modules par instance (F-023). Défaut = activé (2997 inchangé).
# Mettre =false pour masquer un module optionnel (page + entrées de nav).
# Modules fixes non concernés : Dashboard, Profil, Admin, War Tracker, KvK (dont Course).
# VITE_MODULE_BANK=false
# VITE_MODULE_TROPHIES=false
# VITE_MODULE_DEADWEIGHT=false

# Mode d'authentification de l'instance. Défaut = Discord activé (2997 et le
# pilote 3341 inchangés). Mettre =false sur un royaume SANS application Discord
# dédiée : le bouton de connexion Discord, la liaison de compte dans /profile et
# les copies « connectez-vous via Discord » des pages restreintes disparaissent.
# L'auth passe alors par Google, et les rôles sont épinglés à la main dans
# roles/{uid} (Admin SDK). Voir src/config/auth.js.
# VITE_AUTH_DISCORD=false
