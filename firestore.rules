rules_version = '2';

// Durcissement issu de l'audit de sécurité BUG-002 (2026-07-22).
// Rapport : docs/qa/Audit_Securite_Firestore_2026-07-22.md
// Couverture vérifiée par tests/firestore-rules.test.mjs (npm run test:rules).
//
// Traite H-1, M-1, M-2, M-3, B-2, B-3.
// Ne traite PAS B-1 (lecture publique de static_data / kvk_history) : arbitrage produit en attente
// sur le sort du Dashboard visiteur.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // B-3 : un seul get() par évaluation, et un défaut explicite si le document
    // de rôle n'existe pas (avant : get().data.role levait une erreur).
    function role() {
      return isAuthenticated()
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', 'Guest')
        : 'Guest';
    }

    // Admin (opérateur) = super-admin AU-DESSUS du Roi : hérite de tous les pouvoirs
    // du Roi côté serveur (décision Roi 2026-08-13, A-033/BR-020). Attribué par env
    // ROLE_ADMIN_USER_IDS dans functions/discordAuth.js. Les helpers Roi l'incluent donc.
    function isKingOrOfficer() {
      return role() in ['King', 'Officer', 'Admin'];
    }

    function isKing() {
      return role() in ['King', 'Admin'];
    }

    // BR-022 : les déclarations (war_availabilities) sont GELÉES dès que la campagne
    // active a démarré (startDate passée). Seul le ROI (admin) garde le droit de
    // corriger — les Officiers sont gelés comme les Warriors (décision Roi 2026-08-13,
    // révision). `startDate` absente / pas de campagne courante → ouvert (rien à geler).
    function activeStartDate() {
      return exists(/databases/$(database)/documents/kvk_config/current)
        ? get(/databases/$(database)/documents/kvk_config/current).data.get('startDate', null)
        : null;
    }

    function declarationsOpen() {
      return activeStartDate() == null || request.time < activeStartDate();
    }

    // M-3 : garde-fou de forme. `keys()` couvre la création, `diff()` la mise à jour.
    function writesOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- Données de jeu (lecture publique — B-1 non traité) ----------

    match /static_data/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // F-015 / BR-012 : archive immuable, sauf le résultat officiel saisi par le Roi.
    match /kvk_history/{kvkId} {
      allow read: if true;
      allow create: if isKing();
      allow update: if isKing() && changesOnly(['outcome']);
      allow delete: if false;
    }

    // ---------- Identité et rôles ----------

    // B-2 : plus de lecture publique. L'écriture reste réservée à l'Admin SDK
    // (synchro des rôles Discord), inchangé.
    match /roles/{userId} {
      allow read: if isOwner(userId) || isKingOrOfficer();
      allow write: if false;
    }

    // H-1 : le propriétaire ne peut plus écrire que sa liaison de gouverneur.
    // discordId / discordUid / role sont des clés d'identité consommées par le bot
    // et par le gate BR-008 : Functions uniquement (Admin SDK, bypass des règles).
    // L'écriture par le leadership est retirée — aucun code client ne l'utilisait.
    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isKingOrOfficer();
      // E-007/F-025 : multi-comptes — le propriétaire écrit governorId (miroir du
      // compte primaire) + accounts[] (liste de ses comptes typés war/filler).
      // E-010/BR-027 : `warGovernorIds` est le MIROIR PLAT des comptes `war` de
      // `accounts[]`, maintenu par AuthContext. Il n'ajoute aucun droit — il rend
      // seulement la réclamation lisible par une règle, qui ne sait pas itérer une
      // liste de maps. Écrit par le propriétaire comme le reste : un joueur qui le
      // falsifierait ne gagnerait que ce que la réclamation libre lui donne déjà (A-023).
      allow create: if isOwner(userId) && writesOnly(['governorId', 'accounts', 'warGovernorIds', 'updatedAt']);
      allow update: if isOwner(userId) && changesOnly(['governorId', 'accounts', 'warGovernorIds', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- Campagnes et déclarations ----------

    // M-2 : aligné sur l'UI (page Administration, Roi uniquement).
    // La campagne active est le point d'ancrage de toutes les déclarations.
    match /kvk_config/{document} {
      allow read: if isAuthenticated();
      allow write: if isKing();
    }

    // M-1 : la création doit porter son propre userId.
    // Le leadership garde le droit d'écrire pour autrui : l'outil de fusion de
    // campagnes (MaintenanceTools) recrée des déclarations sous le userId d'origine,
    // et l'historique contient des déclarations 'guest'.
    // BR-022 : gel des écritures dès que la campagne a démarré — seul le ROI (admin)
    // peut encore corriger une déclaration (les Officiers sont gelés).
    match /war_availabilities/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && (request.resource.data.userId == request.auth.uid || isKingOrOfficer())
        && (declarationsOpen() || isKing());
      allow update, delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isKingOrOfficer())
        && (declarationsOpen() || isKing());
    }

    // ---------- Leadership ----------

    match /bank_deposits/{document} {
      allow read: if isAuthenticated();
      allow write: if isKingOrOfficer();
    }

    match /deadweight_list/{document} {
      allow read: if isAuthenticated();
      allow write: if isKingOrOfficer();
    }

    // ---------- KvK Race (E-005, décision §9.4) ----------

    match /kvk_race/{campaignId} {
      allow read: if isKingOrOfficer();
      allow create, update: if isKing();
      allow delete: if false;

      // Agrégats écrits par les Functions (Admin SDK).
      match /{document=**} {
        allow read: if isKingOrOfficer();
        allow write: if false;
      }
    }

    // ---------- Programme de mentorat (E-010 / F-039, BR-027) ----------
    //
    // La fiche est clée par `governorId`, PAS par uid. C'est la décision
    // structurante du MVP : 23 des 41 comptes principaux de 2997 n'ont aucun
    // utilisateur (mesuré le 2026-10-21), et un mentor doit pouvoir remplir leur
    // fiche. Une clé par uid rendrait le critère « 100 % des comptes » inatteignable.
    //
    // Contrepartie assumée : la propriété côté joueur repose sur la réclamation de
    // compte, qui n'est pas vérifiée (A-023). Le risque est réel mais marginal
    // AUJOURD'HUI, `war_availabilities` exposant déjà ressources, accélérateurs et
    // commandants de 123 joueurs à tout compte connecté. Durcissement prévu en 1b
    // (`claimVerified` posé par le leadership), à traiter avec ce correctif-là.

    // Le gouverneur fait-il partie des comptes PRINCIPAUX réclamés par l'appelant ?
    //
    // On lit `warGovernorIds`, une liste plate d'identifiants maintenue par
    // AuthContext à côté de `accounts[]`. Itérer `accounts[]` n'est pas possible :
    // les règles ne savent comparer que des maps ENTIÈRES, donc le moindre champ
    // supplémentaire (`name`) ferait échouer la comparaison en silence.
    // `exists()` avant `get()` : un profil absent ferait lever `.data` sur null.
    function hasClaimed(governorId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
             .data.get('warGovernorIds', []).hasAny([governorId]);
    }

    // BR-027 : le leadership (Officer+) OU le joueur qui a réclamé ce gouverneur.
    // Pas de scoping par mentor : les 9 mentors SONT membres du Conseil, qui lit
    // toutes les fiches (B11) — un test relationnel ne protégerait rien.
    function canAccessSheet(governorId) {
      return isKingOrOfficer() || hasClaimed(governorId);
    }

    match /mentoring_sheets/{governorId} {
      allow read: if canAccessSheet(governorId);

      // `enteredBy` trace QUI a saisi — le joueur voit « remplie par ton mentor »,
      // et le Conseil sait à quel mentor réclamer une fiche manquante (B10).
      allow create: if canAccessSheet(governorId)
        && request.resource.data.governorId == governorId
        && request.resource.data.enteredBy == request.auth.uid
        && writesOnly(['governorId', 'name', 'blocks', 'blockMeta', 'status',
                       'enteredBy', 'enteredByRole', 'createdAt', 'updatedAt']);

      allow update: if canAccessSheet(governorId)
        && request.resource.data.enteredBy == request.auth.uid
        && changesOnly(['name', 'blocks', 'blockMeta', 'status',
                        'enteredBy', 'enteredByRole', 'updatedAt']);

      // Droit à l'effacement : le propriétaire réclamant, ou le Roi.
      allow delete: if isKing() || hasClaimed(governorId);

      // Versions figées (BR-028) : create-only, jamais modifiables. C'est le
      // critère de réussite n°5 — « l'ancienne version reste consultable ».
      // `takenAt` est horodaté par le serveur : une version ne peut pas être
      // antidatée. Même parti pris que kvk_history (BR-006).
      match /versions/{versionId} {
        allow read: if canAccessSheet(governorId);
        allow create: if canAccessSheet(governorId)
          && request.resource.data.takenAt == request.time
          && request.resource.data.takenBy == request.auth.uid;
        allow update: if false;
        allow delete: if isKing() || hasClaimed(governorId);
      }
    }

    // Périmètre et paramètres du programme. Le Roi l'amorce ; le Conseil le lit
    // pour afficher le suivi. Le périmètre est une COPIE de la liste de suivi du
    // Roi, jamais une lecture directe de static_data/kvk : celle-ci est réécrite
    // à chaque ouverture de KvK et ferait bouger le dénominateur tout seul.
    match /mentoring_program/{document} {
      allow read: if isKingOrOfficer();
      allow write: if isKing();
    }

    // Tout le reste — dont _discord_oauth_cache et _discord_link_tokens — reste
    // refusé par défaut aux clients.
  }
}
